# Copy this file to ".env" (same folder) and fill in real values. Never commit ".env".

# --- PostgreSQL ---------------------------------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://fintech:1234@localhost:5432/fintech_analytics

# --- API server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
# At least 32 random characters. Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# --- Python analytics ----------------------------------------------------------
# Windows usually "python" (or "py"); Linux/macOS "python3"
PYTHON_BIN=python

# --- Uploads --------------------------------------------------------------------
MAX_UPLOAD_MB=10

# --- Demonstration accounts -----------------------------------------------------
# Password given to the four demo users (admin@demo.local, analyst@demo.local,
# regulator@demo.local, management@demo.local) by "npm run seed". Min 8 chars, letters + digits.
DEMO_PASSWORD=CHANGE_ME_Demo2026
